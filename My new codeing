<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Demo App</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background-color: #f7f8fc;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      color: #333;
    }

    .app-container {
      width: 100%;
      max-width: 400px;
      min-height: 100vh;
      background: #ffffff;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    }

    /* Top Section */
    .top-section {
      padding: 30px 24px 10px;
      text-align: center;
    }

    .logo-container {
      width: 90px;
      height: 90px;
      margin: 0 auto 16px;
      background: #f0edff;
      border-radius: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 12px rgba(99, 102, 241, 0.15);
    }

    .logo-container svg {
      width: 48px;
      height: 48px;
      fill: #5b21b6;
    }

    .app-title {
      font-size: 20px;
      font-weight: 700;
      color: #1e1b4b;
      margin-bottom: 6px;
    }

    .welcome-text {
      font-size: 16px;
      font-weight: 600;
      color: #6d28d9;
      margin-bottom: 20px;
    }

    /* Input Field */
    .input-wrapper {
      position: relative;
      margin-bottom: 16px;
    }

    .input-wrapper input {
      width: 100%;
      height: 52px;
      border: 1.5px solid #d8b4fe;
      border-radius: 12px;
      padding: 0 16px 0 44px;
      font-size: 20px;
      letter-spacing: 4px;
      text-align: left;
      background: #faf5ff;
      color: #333;
      outline: none;
    }

    .input-icon {
      position: absolute;
      left: 16px;
      top: 50%;
      transform: translateY(-50%);
      color: #8b5cf6;
      font-size: 18px;
    }

    /* Submit Button */
    .btn-login {
      width: 100%;
      height: 50px;
      background: #c59b27;
      color: #ffffff;
      border: none;
      border-radius: 25px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: opacity 0.2s;
    }

    .btn-login:active {
      opacity: 0.85;
    }

    /* Numeric Keypad */
    .keypad {
      padding: 10px 20px 20px;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }

    .key {
      background: #f3f4f6;
      border: none;
      border-radius: 14px;
      height: 54px;
      font-size: 20px;
      font-weight: 600;
      color: #1f2937;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      user-select: none;
    }

    .key:active {
      background: #e5e7eb;
    }

    .key svg {
      width: 20px;
      height: 20px;
      stroke: #374151;
      stroke-width: 2;
      fill: none;
    }

    /* Bottom Navigation */
    .bottom-nav {
      height: 60px;
      border-top: 1px solid #f1f1f1;
      display: flex;
      justify-content: space-around;
      align-items: center;
      padding-bottom: env(safe-area-inset-bottom);
    }

    .nav-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      font-size: 12px;
      color: #6b7280;
      cursor: pointer;
    }

    .nav-item.active {
      color: #7c3aed;
      font-weight: 600;
    }
  </style>
</head>
<body>

  <div class="app-container">
    <!-- Top Section -->
    <div class="top-section">
      <div class="logo-container">
        <!-- Generic Modern Shield/Lock Icon -->
        <svg viewBox="0 0 24 24">
          <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 6c1.4 0 2.5 1.1 2.5 2.5V11c.6 0 1 .4 1 1v4c0 .6-.4 1-1 1h-5c-.6 0-1-.4-1-1v-4c0-.6.4-1 1-1V9.5C9.5 8.1 10.6 7 12 7zm0 2c-.3 0-.5.2-.5.5V11h1V9.5c0-.3-.2-.5-.5-.5z"/>
        </svg>
      </div>

      <div class="app-title">Demo Banking App</div>
      <div class="welcome-text">Welcome</div>

      <div class="input-wrapper">
        <span class="input-icon">🔒</span>
        <input type="password" id="pin-input" placeholder="PIN" readonly />
      </div>

      <button class="btn-login" onclick="handleSubmit()">Login</button>
    </div>

    <!-- Keypad Section -->
    <div>
      <div class="keypad">
        <button class="key" onclick="pressKey('1')">1</button>
        <button class="key" onclick="pressKey('2')">2</button>
        <button class="key" onclick="pressKey('3')">3</button>
        <button class="key" onclick="pressKey('4')">4</button>
        <button class="key" onclick="pressKey('5')">5</button>
        <button class="key" onclick="pressKey('6')">6</button>
        <button class="key" onclick="pressKey('7')">7</button>
        <button class="key" onclick="pressKey('8')">8</button>
        <button class="key" onclick="pressKey('9')">9</button>
        <button class="key" onclick="deleteKey()">
          <!-- Backspace Icon -->
          <svg viewBox="0 0 24 24">
            <path d="M21 4H8l-7 8 7 8h13a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2z"></path>
            <line x1="18" y1="9" x2="12" y2="15"></line>
            <line x1="12" y1="9" x2="18" y2="15"></line>
          </svg>
        </button>
        <button class="key" onclick="pressKey('0')">0</button>
        <button class="key" onclick="handleSubmit()">
          <!-- Checkmark Icon -->
          <svg viewBox="0 0 24 24">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </button>
      </div>

      <!-- Bottom Nav -->
      <div class="bottom-nav">
        <div class="nav-item active">🏠 Home</div>
        <div class="nav-item">📊 Stats</div>
        <div class="nav-item">👤 Profile</div>
